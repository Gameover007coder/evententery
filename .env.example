# MongoDB
MONGO_URI=mongodb://localhost:27017/qr-event-app

# Server
PORT=4000

# JWT secret for admin login sessions
JWT_SECRET=change_this_to_a_long_random_string

# Admin login credentials (simple single-admin setup)
# In production, move this to a proper Admins collection with hashed passwords.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# SMTP (example uses Gmail; for production use SendGrid/Mailgun/etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Event Team <your_email@gmail.com>"

# Event details used in the pass email
EVENT_NAME=My Awesome Event
EVENT_DATE=2026-12-01
EVENT_VENUE=Main Hall

# Server
PORT=4000

# Admin login credentials
ADMIN_ID=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# JWT secret for admin sessions
JWT_SECRET=super_secret_event_jwt_key_2026_antigravity

# Event details
EVENT_NAME=Grand Tech & Cultural Fest 2026
EVENT_DATE=2026-10-15
EVENT_VENUE=Auditorium Hall A

# Optional MongoDB URI (if empty or unreachable, falls back to local JSON database automatically)
MONGO_URI=mongodb://localhost:27017/qr-event-app

# Optional SMTP for sending emails (passes will still be shown and downloadable on-screen)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Event Team <events@example.com>"
